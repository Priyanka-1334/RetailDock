# Database Configuration
POSTGRES_USER=retaildock
POSTGRES_PASSWORD=retaildock_password
POSTGRES_DB=retaildock_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://retaildock:retaildock_password@postgres:5432/retaildock_db

# Security & JWT Configuration
JWT_SECRET_KEY=retaildock_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Application Settings
ENVIRONMENT=development
PROJECT_NAME=RetailDock
